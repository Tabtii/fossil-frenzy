{
  "name": "fossil-frenzy",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
